---
// Starlight's footer, plus links to the machine-readable copies of these docs:
// on a GitHub project page a link is the only way to advertise llms.txt (no
// HTTP `Link:` headers, and crawlers never fetch a robots.txt below the root).
import Default from '@astrojs/starlight/components/Footer.astro';
import { Icon } from '@astrojs/starlight/components';
import { base } from '../base';
import { REPO, REPO_URL } from '../site.mjs';

const markdownUrl = Astro.locals.starlightRoute.head.find(
  ({ tag, attrs }) => tag === 'link' && attrs?.rel === 'alternate' && attrs.type === 'text/markdown'
)?.attrs?.href;
---

<Default><slot /></Default>

<footer class="rc-footer">
  <p>
    For AI assistants:{' '}
    {markdownUrl && (
      <>
        <a href={markdownUrl}>this page as Markdown</a>,{' '}
      </>
    )}
    <a href={`${base}/llms.txt`}>llms.txt</a>
  </p>
  <a class="rc-footer-github" href={REPO_URL}>
    <Icon name="github" size="1.25rem" />
    {REPO}
  </a>
</footer>

<style>
  /* The shadow and clip-path stretch the background to the viewport edges
     without overflowing it; the negative margin cancels the content panel's
     bottom padding so the band sits on the bottom of the page. */
  .rc-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin: 3rem 0 -1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--sl-color-hairline);
    background: var(--rc-color-surface);
    box-shadow: 0 0 0 100vmax var(--rc-color-surface);
    clip-path: inset(0 -100vmax -100vmax);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .rc-footer p {
    margin: 0;
    max-width: 40rem;
  }

  .rc-footer-github {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }

  .rc-footer-github:hover {
    color: var(--sl-color-white);
  }
</style>
