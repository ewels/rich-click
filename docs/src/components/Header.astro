---
// Wraps Starlight's default header with a Material-for-MkDocs style tabs row
// linking the top-level site sections, plus a docs version dropdown.
import Default from '@astrojs/starlight/components/Header.astro';
import { base } from '../base';
import { entryPath, sidebar } from '../site.mjs';

// One tab per top-level sidebar entry, active for any URL under its section.
const tabs = sidebar.map((entry) => {
  const rootPath = entryPath(entry);
  const section = rootPath.split('/').filter(Boolean)[0];
  return {
    label: entry.label,
    href: `${base}${rootPath}`,
    match: section === undefined ? /^\/$/ : new RegExp(`^/${section}/`),
  };
});

const currentPath = Astro.url.pathname.slice(base.length) || '/';

// Deployed docs versions, injected at build time by docs/_deploy.py (absent in
// local development). Rendered as static per-page links: same mike-format data
// that is also written to versions.json at the deployment root.
interface VersionEntry {
  version: string;
  title: string;
  aliases: string[];
}
const versions: VersionEntry[] = JSON.parse(process.env.DOCS_VERSIONS ?? '[]');
const parts = base.split('/');
const currentVersion = parts.at(-1) ?? '';
const deployRoot = parts.slice(0, -1).join('/');
const pagePath = Astro.url.pathname.slice(base.length + 1);
const versionLinks = versions.map(({ version, title, aliases }) => ({
  label: aliases.length > 0 ? `${title} (${aliases.join(', ')})` : title,
  href: `${deployRoot}/${version}/${pagePath}`,
  current: version === currentVersion || aliases.includes(currentVersion),
}));
const currentLabel = versionLinks.find((v) => v.current)?.label ?? currentVersion;
---

<div class="rc-header-main">
  <div class="rc-header-default"><Default><slot /></Default></div>
  {
    versionLinks.length > 0 && (
      <details class="rc-version-select">
        <summary>
          <span class="sr-only">Documentation version: </span>
          {currentLabel} ▾
        </summary>
        <ul>
          {versionLinks.map((link) => (
            <li>
              <a href={link.href} aria-current={link.current ? 'true' : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    )
  }
</div>
<nav class="rc-header-tabs sl-hidden lg:sl-flex" aria-label="Site sections">
  <ul>
    {
      tabs.map((tab) => (
        <li>
          <a href={tab.href} aria-current={tab.match.test(currentPath) ? 'true' : undefined}>
            {tab.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .rc-header-main {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .rc-header-default {
    flex: 1;
    min-width: 0;
    height: 100%;
  }

  /* On large screens the header grows (see custom.css) to fit the tabs row. */
  @media (min-width: 72rem) {
    .rc-header-main {
      height: calc(100% - var(--rc-tabs-height));
    }
  }

  .rc-header-tabs {
    height: var(--rc-tabs-height);
    align-items: center;
    gap: 1rem;
  }

  .rc-header-tabs ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
  }

  .rc-header-tabs a {
    display: block;
    color: var(--sl-color-header-text, var(--sl-color-white));
    opacity: 0.7;
    text-decoration: none;
    font-size: var(--sl-text-sm);
    padding: 0.35rem 0;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }

  .rc-header-tabs a:hover {
    opacity: 1;
  }

  .rc-header-tabs a[aria-current='true'] {
    opacity: 1;
    border-bottom-color: currentColor;
    font-weight: 600;
  }

  .rc-version-select {
    position: relative;
    color: var(--sl-color-header-text, var(--sl-color-white));
    font-size: var(--sl-text-xs);
  }

  .rc-version-select > summary {
    list-style: none;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    border: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    border-radius: 0.25rem;
    padding: 0.15rem 0.5rem;
  }

  .rc-version-select > summary::-webkit-details-marker {
    display: none;
  }

  .rc-version-select ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.25rem);
    z-index: 10;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    min-width: 100%;
    background-color: var(--sl-color-black, #181818);
    border: 1px solid var(--sl-color-gray-5, #444);
    border-radius: 0.25rem;
    box-shadow: var(--sl-shadow-md);
  }

  .rc-version-select a {
    display: block;
    padding: 0.25rem 0.75rem;
    border-radius: 0.2rem;
    color: var(--sl-color-gray-2, #ccc);
    text-decoration: none;
    white-space: nowrap;
  }

  .rc-version-select a:hover {
    background-color: color-mix(in srgb, currentColor 15%, transparent);
  }

  .rc-version-select a[aria-current='true'] {
    font-weight: 600;
    color: var(--sl-color-header-text, var(--sl-color-white));
  }
</style>

<script>
  // Click-to-zoom for content images (replaces mkdocs-glightbox).
  // starlight-image-zoom can't be used here: it wraps images with a rehype
  // plugin, which the Sätteri Markdown processor doesn't run
  // (https://github.com/HiDeoo/starlight-image-zoom/issues/63). medium-zoom
  // works purely client-side, so it is processor-agnostic.
  import mediumZoom from 'medium-zoom';

  // Skip linked images and the landing page badge rows (which custom.css
  // deliberately styles as non-clickable).
  const images = document.querySelectorAll<HTMLImageElement>(
    '.sl-markdown-content img:not(a img):not(p[align="center"] img)'
  );
  if (images.length > 0) {
    mediumZoom(images, {
      margin: 32,
      background: getComputedStyle(document.documentElement).getPropertyValue('--rc-zoom-backdrop'),
    });
  }
</script>

<script>
  // Client-side mermaid rendering for `<pre class="mermaid">` diagrams
  // (produced by plugins/satteri-mermaid.mjs), re-rendered on theme change.
  const diagrams = document.querySelectorAll<HTMLPreElement>('pre.mermaid');
  if (diagrams.length > 0) {
    for (const diagram of diagrams) {
      diagram.dataset.source = diagram.textContent ?? '';
    }

    const render = async () => {
      const { default: mermaid } = await import('mermaid');
      const dark = document.documentElement.dataset.theme === 'dark';
      let count = 0;
      for (const diagram of diagrams) {
        diagram.textContent = diagram.dataset.source ?? '';
        diagram.removeAttribute('data-processed');
        diagram.id = `rc-mermaid-${++count}`;
      }
      mermaid.initialize({
        startOnLoad: false,
        theme: dark ? 'dark' : 'default',
        fontFamily: 'var(--sl-font-system)',
      });
      await mermaid.run({ nodes: diagrams });
    };

    render();

    const observer = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        if (mutation.attributeName === 'data-theme') render();
      }
    });
    observer.observe(document.documentElement, { attributes: true });
  }
</script>
