---
// Overrides Starlight's Hero, which only renders on pages with `hero` frontmatter (the homepage).
import { LinkButton } from '@astrojs/starlight/components';
import { base } from '../base';
import { ansiToHtmlLines } from '../ansi';
// @ts-expect-error -- untyped project-local JavaScript module.
import { SITE_TAGLINE } from '../site.mjs';
import themeCounts from '../generated/theme-counts.json';
// Inlined rather than <img> so the CSS below can move the text apart from its shadow.
import lightLogo from '../../public/images/rich-click-light-animated.svg?raw';
import darkLogo from '../../public/images/rich-click-dark-animated.svg?raw';

// Generated by rich-codex (.rich-codex.yml).
const captures = import.meta.glob<string>('../content/docs/images/code_snippets/homepage/sync_tool_*.ansi', {
  query: '?raw',
  import: 'default',
  eager: true,
});


const formats = ['box', 'nu', 'slim', 'modern', 'robo', 'square'].map((name) => ({
  name,
  lines: ansiToHtmlLines(captures[`../content/docs/images/code_snippets/homepage/sync_tool_${name}.ansi`]),
}));

// Swatch roles are picked per scheme to show three distinct colours.
const schemes = [
  { name: 'default', swatches: ['c', 'y', 'g'] },
  { name: 'nord', swatches: ['c', 'y', 'b'] },
  { name: 'dracula', swatches: ['c', 'y', 'g'] },
  { name: 'forest', swatches: ['c', 'y', 'r'] },
];
const installCommand = 'pip install rich-click';
---

<div class="rc-hero not-content">
  <div class="rc-hero-copy">
    <h1 id="_top" class="rc-logo" data-page-title>
      <span class="dark:sl-hidden" set:html={lightLogo} />
      <span class="light:sl-hidden" set:html={darkLogo} />
    </h1>
    <p class="rc-hero-tagline">{SITE_TAGLINE}</p>
    <p class="rc-hero-lede">
      Beautiful help text and error messages for your Click CLI, formatted with Rich. Change one import
      and you’re done.
    </p>
    <div class="rc-install">
      <span class="rc-install-prompt" aria-hidden="true">$</span>
      <code>{installCommand}</code>
      <button type="button" class="rc-copy" data-copy={installCommand} aria-label="Copy install command">
        <span class="rc-copy-done" hidden>Copied</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
      </button>
    </div>
    <div class="rc-hero-actions">
      <LinkButton class="rc-link-button" href={`${base}/documentation/quickstart/`} icon="right-arrow">
        Get started
      </LinkButton>
      <LinkButton class="rc-link-button" href={`${base}/editor/`} variant="secondary">
        Try the Live Style Editor
      </LinkButton>
    </div>
  </div>

  <div class="rc-demo">
    <div class="rc-term" data-scheme={schemes[0].name}>
      <div class="rc-term-body" tabindex="0" aria-label="Example rich-click help output">
        <div class="rc-term-line rc-term-command"><span class="rc-term-prompt">$ </span><strong>sync-tool</strong> --help</div>
        {
          formats.map(({ name, lines }, i) => (
            <div data-output={name} hidden={i !== 0}>
              {lines.map((line) => <div class="rc-term-line" set:html={line} />)}
            </div>
          ))
        }
      </div>
    </div>

    <div class="rc-pickers">
      <div class="rc-picker" role="group" aria-label="Colour scheme">
        {
          schemes.map(({ name, swatches }, i) => (
            <button type="button" class="rc-chip" data-scheme-option={name} aria-pressed={String(i === 0)}>
              <span class="rc-swatches" data-scheme={name} aria-hidden="true">
                {swatches.map((role) => <span style={`background: var(--${role})`} />)}
              </span>
              {name}
            </button>
          ))
        }
        <a class="rc-picker-more" href={`${base}/documentation/themes/`}>+ {themeCounts.colours - schemes.length} more</a>
      </div>
      <div class="rc-picker" role="group" aria-label="Format">
        {
          formats.map(({ name }, i) => (
            <button type="button" class="rc-chip" data-format-option={name} aria-pressed={String(i === 0)}>
              {name}
            </button>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  // Clicking the logo spins its squares like slot-machine reels: each cycles
  // through the logo's colours, slowing down, and stops left to right on its own.
  const SPIN_MS = 1000;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  for (const logo of document.querySelectorAll<HTMLElement>('.rc-logo')) {
    let spin = 0;
    logo.addEventListener('click', () => {
      if (reduceMotion.matches) return;
      const id = ++spin;
      for (const svg of logo.querySelectorAll('svg')) {
        const squares = [...svg.querySelectorAll<SVGRectElement>('rect')];
        const colours = squares.map((square) => square.getAttribute('fill')!);
        const start = performance.now();
        squares.forEach((square, i) => {
          const stop = SPIN_MS * (0.55 + (0.45 * i) / (squares.length - 1));
          let next = 0;
          const tick = (now: number) => {
            if (id !== spin) return;
            const elapsed = now - start;
            if (elapsed >= stop) {
              square.style.removeProperty('fill');
              return;
            }
            if (elapsed >= next) {
              const others = colours.filter((colour) => colour !== square.style.fill);
              square.style.fill = others[Math.floor(Math.random() * others.length)];
              // Changes every 30ms at first, easing out to every 180ms by the stop.
              next = elapsed + 30 + 150 * (elapsed / stop) ** 2;
            }
            requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      }
    });
  }

  for (const demo of document.querySelectorAll<HTMLElement>('.rc-demo')) {
    const term = demo.querySelector<HTMLElement>('.rc-term')!;
    const outputs = term.querySelectorAll<HTMLElement>('[data-output]');
    for (const key of ['scheme', 'format'] as const) {
      const buttons = demo.querySelectorAll<HTMLButtonElement>(`[data-${key}-option]`);
      for (const button of buttons) {
        button.addEventListener('click', () => {
          const value = button.getAttribute(`data-${key}-option`)!;
          if (key === 'scheme') term.dataset.scheme = value;
          else for (const output of outputs) output.hidden = output.dataset.output !== value;
          for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
        });
      }
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.rc-copy')) {
    const done = button.querySelector<HTMLElement>('.rc-copy-done')!;
    let timer: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy!);
      done.hidden = false;
      clearTimeout(timer);
      timer = setTimeout(() => (done.hidden = true), 1500);
    });
  }
</script>

<style>
  .rc-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 3.5rem;
    padding-block: 3rem 3.5rem;
  }

  .rc-hero-copy {
    flex: 1 1 24rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  h1 {
    margin: 0 0 1rem;
    line-height: 0;
  }

  /* Visible overflow: the raised text pokes past the viewBox's top and right edges. */
  .rc-logo :global(svg) {
    display: block;
    overflow: visible;
    width: 100%;
    max-width: 30rem;
    height: auto;
  }

  /* The text is the SVG's only top-level path; its shadow sits 5 units down
     and left. Hover lifts the text away from the shadow, and pressing sinks it
     onto the shadow until the button is released. */
  .rc-logo {
    user-select: none;
  }

  .rc-logo :global(svg > path) {
    transition: transform 0.15s ease;
  }

  .rc-logo:hover :global(svg > path) {
    transform: translate(1px, -1px);
  }

  .rc-logo:active :global(svg > path) {
    transform: translate(-5px, 5px);
    transition-duration: 0.05s;
  }

  @media (prefers-reduced-motion: reduce) {
    .rc-logo:is(:hover, :active) :global(svg > path) {
      transform: none;
    }
  }

  .rc-hero-tagline {
    margin: 0;
    max-width: 30ch;
    font-size: var(--sl-text-2xl);
    line-height: 1.4;
    color: var(--sl-color-white);
  }

  .rc-hero-lede {
    margin: 0;
    max-width: 46ch;
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  .rc-install {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 26rem;
    height: 3rem;
    padding: 0 0.5rem 0 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.625rem;
    background: var(--rc-color-surface);
    font-family: var(--rc-mono-font);
    font-size: var(--sl-text-base);
  }

  .rc-install code {
    flex-grow: 1;
    color: var(--sl-color-white);
    background: none;
    padding: 0;
  }

  .rc-install-prompt {
    color: var(--sl-color-gray-3);
  }

  .rc-copy {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.5rem;
    justify-content: center;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-3);
    font: inherit;
    font-size: var(--sl-text-xs);
    cursor: pointer;
  }

  .rc-copy:hover {
    color: var(--sl-color-white);
  }

  .rc-copy-done {
    color: var(--sl-color-green-high);
  }

  .rc-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Hidden until both columns get room for the 62-column terminal output. */
  .rc-demo {
    display: none;
    min-width: 0;
    flex-direction: column;
    gap: 0.875rem;
  }

  @media (min-width: 74rem) {
    .rc-hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }

    /* Size containment keeps the terminal out of the row height, so the
       column stretches to the copy's height and the output scrolls. */
    .rc-demo {
      display: flex;
      contain: size;
    }
  }

  .rc-term {
    --rc-term-fg: #d7dae0;
    --rc-term-border: #3d4252;
    --rc-term-rule: rgba(255, 255, 255, 0.1);
    --rc-term-strong: #fff;
    --rc-term-prompt: #6f7590;
    --rc-term-shadow: rgba(0, 0, 0, 0.6);
    flex: 1 1 0;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--rc-term-border);
    border-radius: 0.875rem;
    background: var(--rc-color-panel);
    color: var(--rc-term-fg);
    box-shadow: 0 0.5rem 1.25rem var(--rc-term-shadow);
  }

  :global([data-theme='light']) .rc-term {
    --rc-term-fg: #2b2f3a;
    --rc-term-border: #c3c8d2;
    --rc-term-rule: rgba(0, 0, 0, 0.08);
    --rc-term-strong: #000;
    --rc-term-prompt: #878b9c;
    --rc-term-shadow: rgba(30, 35, 60, 0.22);
  }

  .rc-term-body {
    height: 100%;
    overflow: auto;
    padding: 1.125rem 1.25rem 1.375rem;
    font-family: var(--rc-mono-font);
    font-size: 0.8125rem;
    line-height: 1.5;
    font-variant-ligatures: none;
  }

  .rc-term-line {
    min-height: 1.5em;
    white-space: pre;
  }

  .rc-term-command {
    /* Cancels .rc-term-body's inline padding so the border spans edge to edge. */
    margin: 0 -1.25rem 0.75rem;
    padding: 0 1.25rem 0.625rem;
    border-bottom: 1px solid var(--rc-term-rule);
  }

  .rc-term-command strong {
    color: var(--rc-term-strong);
  }

  .rc-term-prompt {
    color: var(--rc-term-prompt);
  }

  /* Colour schemes recolour the roles ansiToHtmlLines() assigns, approximating
     each scheme's palette (see COLORS in rich_click_theme.py). */
  .rc-term :global(.c),
  .rc-term :global(.y),
  .rc-term :global(.b),
  .rc-term :global(.g) {
    font-weight: 700;
  }

  [data-scheme='default'] {
    --c: #56b6c2;
    --y: #e5c07b;
    --yl: #e5c07b;
    --g: #98c379;
    --r: #e06c75;
    --d: #6f7590;
    --b: #ffffff;
  }

  [data-scheme='nord'] {
    --c: #5e81ac;
    --y: #b48ead;
    --yl: #d8dee9;
    --g: #88c0d0;
    --r: #bf616a;
    --d: #4c566a;
    --b: #8fbcbb;
  }

  [data-scheme='dracula'] {
    --c: #ff79c6;
    --y: #50fa7b;
    --yl: #50fa7b;
    --g: #bd93f9;
    --r: #ff5555;
    --d: #6272a4;
    --b: #f8f8f2;
  }

  [data-scheme='forest'] {
    --c: #98c379;
    --y: #e5c07b;
    --yl: #f4f7ef;
    --g: #98c379;
    --r: #b5e890;
    --d: #8a7a4f;
    --b: #98c379;
  }

  /* Darker variants that keep 4.5:1 contrast on the light terminal (dim text excepted). */
  :global([data-theme='light']) [data-scheme='default'] {
    --c: #0b7d8f;
    --y: #946200;
    --yl: #946200;
    --g: #3d7f3c;
    --r: #c8303d;
    --d: #878b9c;
    --b: #1d1f27;
  }

  :global([data-theme='light']) [data-scheme='nord'] {
    --c: #4b6c96;
    --y: #8c5f86;
    --yl: #4c566a;
    --g: #2f7a8c;
    --r: #a8424b;
    --d: #878ea0;
    --b: #2f7a78;
  }

  :global([data-theme='light']) [data-scheme='dracula'] {
    --c: #a3144d;
    --y: #14710a;
    --yl: #14710a;
    --g: #644ac9;
    --r: #cb3a2a;
    --d: #7a7596;
    --b: #1f1f1f;
  }

  :global([data-theme='light']) [data-scheme='forest'] {
    --c: #4a7a2a;
    --y: #856000;
    --yl: #2f3a22;
    --g: #4a7a2a;
    --r: #3f7a1f;
    --d: #857750;
    --b: #4a7a2a;
  }

  .rc-term :global(.c) { color: var(--c); }
  .rc-term :global(.y) { color: var(--y); }
  .rc-term :global(.yl) { color: var(--yl); }
  .rc-term :global(.g) { color: var(--g); }
  .rc-term :global(.r) { color: var(--r); }
  .rc-term :global(.d) { color: var(--d); }
  .rc-term :global(.b) { color: var(--b); }

  .rc-pickers {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .rc-picker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .rc-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.125rem;
    padding: 0 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    font-family: var(--rc-mono-font);
    font-size: var(--sl-text-xs);
    cursor: pointer;
  }

  .rc-chip:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-3);
  }

  .rc-chip[aria-pressed='true'] {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }

  .rc-swatches {
    display: flex;
    gap: 2px;
  }

  .rc-swatches span {
    width: 0.5rem;
    height: 0.5rem;
  }

  .rc-picker-more {
    margin-left: 0.25rem;
    font-size: var(--sl-text-sm);
  }
</style>
