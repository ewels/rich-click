---
// Starlight's PageTitle, but with `backticks` in the frontmatter title rendered
// as inline code. Stands in for '@astrojs/starlight/components/PageTitle.astro'
// via the resolver in astro.config.mjs, because starlight-page-actions'
// PageTitle override imports that path directly.
// Blog posts also get their description and their metadata as a Rich panel of
// options.
import { sitePath } from '../base';
import { isoDate, slug } from '../blog';
import { authorAvatars } from '../avatars';

const PAGE_TITLE_ID = '_top';
const { id, entry } = Astro.locals.starlightRoute;
const parts = entry.data.title.split('`');

const avatars = await authorAvatars();
const post = id.startsWith('blog/') ? Astro.locals.starlightBlog.posts.find((p) => p.entry.id === id) : undefined;
// starlight-blog hides this title on the blog index, which has its own visible
// h1#_top (components/BlogPosts.astro) for the table of contents to target.
const titleId = sitePath(Astro.url) === '/blog/' ? undefined : PAGE_TITLE_ID;
---

<h1 id={titleId}>{parts.map((part, i) => (i % 2 === 1 ? <code>{part}</code> : part))}</h1>
{
  post && (
    <>
      {entry.data.description && <p class="rc-post-dek">{entry.data.description}</p>}
      <dl class="rc-post-meta" data-title="Post">
        {post.authors.map((author) => (
          <>
            <dt>--author</dt>
            <dd>
              <img src={avatars.get(author.name)} alt="" width="20" height="20" />
              {author.url ? <a href={author.url}>{author.name}</a> : author.name}
              {author.title && <span class="rc-muted">{author.title}</span>}
            </dd>
          </>
        ))}
        <dt>--published</dt>
        <dd>
          <time datetime={post.createdAt.toISOString()}>{isoDate(post.createdAt)}</time>
          {post.updatedAt && <span class="rc-muted">updated {isoDate(post.updatedAt)}</span>}
        </dd>
        {post.tags.map(({ label, href }) => (
          <>
            <dt>--tag</dt>
            <dd>
              <a href={href} data-tag={slug(label)}>
                {slug(label)}
              </a>
            </dd>
          </>
        ))}
      </dl>
    </>
  )
}

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }

    /* Matches inline code in content headings, which this h1 sits outside of. */
    h1 code {
      background-color: var(--sl-color-bg-inline-code);
      margin-block: -0.125rem;
      padding: 0.125rem 0.375rem;
    }
  }


  .rc-post-dek {
    margin: 1.25rem 0 0;
    font-size: var(--sl-text-xl);
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  /* A Rich panel: the title sits in the top border. */
  .rc-post-meta {
    position: relative;
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.375rem 1.5rem;
    align-items: center;
    margin: 2rem 0 0;
    padding: 1.125rem 1rem 0.75rem;
    border: 1px solid var(--rc-color-panel-border);
    border-radius: 0.25rem;
    font-family: var(--rc-mono-font);
    font-size: var(--sl-text-sm);
  }

  .rc-post-meta::before {
    content: attr(data-title);
    position: absolute;
    top: -0.75em;
    left: 0.75rem;
    padding: 0 0.375rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-3);
  }

  .rc-post-meta dt {
    color: var(--rc-color-ansi-cyan);
    font-weight: 700;
  }

  .rc-post-meta dd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--sl-color-white);
  }

  .rc-post-meta img {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
  }

  .rc-post-meta a {
    color: inherit;
    text-decoration: none;
  }

  .rc-post-meta a:hover {
    text-decoration: underline;
  }

  .rc-post-meta a[data-tag] {
    color: var(--rc-tag-color);
  }

  .rc-muted {
    color: var(--sl-color-gray-3);
  }
</style>
